# editor
.vs/
.idea/

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
# NuGet v3's project.json files produces more ignorable files
*.nuget.props
*.nuget.targets

release-files/

# Ignore generated file with harvested file paths for WiX
wix/harvested.wxs

# Other WiX files
*.wixobj
*.wixpdb
*.msi

# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
#Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# build result
/build/
dist

.vscode/
.DS_Store
.ccls-cache

# dependencies installed by xtask
deps

# dependencies installed by node
node_modules

# The .gitignore for android is project folder.

# flatpak
.flatpak*

ALVR-Launcher

#allows adding CMake files for some IDEs to parse C++ files correctly
CMakeLists.txt
cmake-build-debug/

*.jks

# Credentials — never commit
metrics/.env
.env

# Local build / install logs written by xtask wrappers, choco runs, vs build tools,
# winget chains, sdkmanager, prepare-deps etc. Dot-prefixed so they sort to the
# top in `ls -a` and stay out of the way; never useful to other clones.
.build-*.log
.cargo-apk-install.log
.check.log
.choco-batch.log
.choco-runner.ps1
.dashboard-test.log
# Catch the accidentally-mangled twin (broken shell quoting on D:\projects\alvr...)
*dashboard-test.log
.monado-smoke-hand.log
.monado-smoke-hand.log.out
.prepare-deps-*.log
.sdkmgr.log
.vs-atl-add.log
.vs-atl-add.ps1
.vsbuildtools-install.log
.winget-chain.log

# Console transcripts from interactive sessions
20[0-9][0-9]-[01][0-9]-[0-3][0-9]-*-local-command-*.txt

# Python bytecode (metrics ingest server)
__pycache__/
*.pyc

# Per-machine Claude Code state. .claude/agents and .claude/commands ARE tracked
# (project-wide tooling); the lock file and local settings overlay are not.
.claude/scheduled_tasks.lock
.claude/settings.local.json